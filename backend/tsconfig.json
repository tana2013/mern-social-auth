{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext", // Crucial for native ESM resolution         
    "moduleResolution": "NodeNext", // Crucial for native ESM resolution
    "rootDir": "./src",
    "outDir": "./dist",
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "skipLibCheck": true
  },
  "include": [
    "src/**/*"
  ]
}